# ======================================================================
# GenBank Environment Configuration Template
# ======================================================================

# Port Configuration
PORT=8080

# Database Configuration (Defaults to local MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/genbank_db
DB_USERNAME=root
DB_PASSWORD=root

# Microservice Configuration
OTP_SERVICE_URL=http://127.0.0.1:8000/api/otp

# ======================================================================
# Optional: Live Email Dispatch (Gmail / Brevo / SendGrid / Amazon SES)
# ======================================================================
# If SMTP_USER and SMTP_PASSWORD are provided, GenBank sends authentic,
# branded HTML emails with OTP codes to applicants' actual email inboxes!
# If left empty, GenBank automatically runs in zero-friction Demo Mode.

# Example for Gmail (Use a 16-character Google App Password, not your login password):
# How to generate: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="GenBank Security"
